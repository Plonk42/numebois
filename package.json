{
  "name": "numebois",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jeu de maths de CE2 : chaque exercice réussi fait grandir une forêt en 3D",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "tsx scripts/build-assets.ts",
    "sounds": "tsx scripts/build-sounds.ts",
    "capture": "tsx scripts/capture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "icons": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "preact": "11.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
